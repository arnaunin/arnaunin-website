---
/** En ple servei: tres moments del servei explicats amb text (sense maquetes del sistema). */
import { textos, type Idioma } from '../../i18n';

interface Props {
  idioma: Idioma;
}

const s = textos(Astro.props.idioma).suite.perDins;
---

<section class="fosc-profund per-dins">
  <div class="contenidor seccio per-dins-cos">
    <div class="per-dins-text revela">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 class="titol">{s.titol}</h2>
      <p class="paragraf">{s.text}</p>
      <p class="demo">
        {s.demo} <a href="#contacte">{s.enllac}&nbsp;→</a>
      </p>
    </div>

    <ol class="moments" role="list">
      {
        s.moments.map((moment, i) => (
          <li class="moment revela">
            <span class="numero" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{moment.titol}</h3>
              <p>{moment.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .per-dins {
    position: relative;
    overflow: hidden;
  }

  .per-dins-cos {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }

  .per-dins-text {
    flex: 1 1 400px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .paragraf {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text-fosc);
  }

  .demo {
    padding-top: 20px;
    border-top: 1px solid var(--color-linia-fosca);
    line-height: 1.6;
    color: var(--color-text-fosc-suau);
  }

  .demo a {
    font-weight: 600;
    white-space: nowrap;
  }

  .moments {
    flex: 1 1 460px;
    min-width: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .moment {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: var(--color-mariner);
    border: 1px solid var(--color-linia-fosca);
    border-radius: var(--radi-targeta);
    padding: 24px;
  }

  .numero {
    flex: none;
    min-width: 2.2rem;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-titol);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-sorra);
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-paper);
  }

  .moment p {
    margin-top: 6px;
    line-height: 1.6;
    color: var(--color-text-fosc);
  }
</style>
