---
/** Hero de La Suite: el missatge principal i, al costat, el resum del que inclou. */
import Icona from '../comu/Icona.astro';
import Llum from '../comu/Llum.astro';
import Marca from '../comu/Marca.astro';
import Onades from '../comu/Onades.astro';
import { textos, type Idioma } from '../../i18n';

interface Props {
  idioma: Idioma;
}

const t = textos(Astro.props.idioma).suite.hero;
const r = t.resum;
---

<section class="hero fosc">
  <Llum mida={480} posicio="right: 10%; top: 8%" />
  <Onades amplada={620} alcada={260} opacitat={0.14} gruix={0.6} posicio="left: -40px; bottom: -20px" />

  <div class="contenidor hero-cos">
    <div class="hero-text">
      <div class="marca-fila entra">
        <Marca fons="fosc" />
        <span class="separador" aria-hidden="true"></span>
        <p class="subtitol">{t.subtitol}</p>
      </div>
      <h1 class="titol-hero entra d1" set:html={t.titolHtml} />
      <p class="entradeta entra d2">{t.entradeta}</p>
      <div class="grup-botons entra d3">
        <a href="#contacte" class="boto boto--principal">{t.botoPrincipal}</a>
        <a href="#per-que" class="boto boto--secundari">{t.botoSecundari}</a>
      </div>
    </div>

    <div class="resum-columna entra d4">
      <div class="resum">
        <div class="ratlla-accent" aria-hidden="true"></div>
        <p class="resum-titol">{r.titol}</p>
        <ul class="resum-llista" role="list">
          {
            r.punts.map((punt) => (
              <li>
                <span class="resum-icona" aria-hidden="true">
                  <Icona nom="check" mida={16} gruix={2.4} />
                </span>
                {punt}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-cos {
    position: relative;
    padding-top: 100px;
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }

  .hero-text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .marca-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .separador {
    width: 48px;
    height: 1px;
    background: var(--color-pissarra);
  }

  .subtitol {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-paper);
  }

  .titol-hero {
    font-family: var(--font-titol);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.06;
    text-wrap: balance;
  }

  .titol-hero :global(em) {
    color: var(--color-sorra);
  }

  .entradeta {
    max-width: 560px;
    font-size: var(--mida-entradeta);
    line-height: 1.65;
    color: var(--color-text-fosc);
  }

  .resum-columna {
    flex: 1 1 380px;
    min-width: 0;
    max-width: 460px;
  }

  .resum {
    position: relative;
    border: 1px solid var(--color-linia-fosca);
    border-radius: var(--radi-panell);
    background: var(--color-vel-fosc);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .resum-titol {
    font-family: var(--font-titol);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.2;
    color: var(--color-paper);
    text-wrap: balance;
  }

  .resum-llista {
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .resum-llista li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--color-linia-fosca);
    font-size: 1.05rem;
    color: var(--color-text-fosc);
  }

  .resum-icona {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--color-pissarra);
    color: var(--color-sorra);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .resum-icona :global(svg) {
    display: inline;
  }

  @media (max-width: 700px) {
    .resum {
      padding: 28px 24px;
    }

    .hero-cos {
      padding-top: 56px;
      padding-bottom: 88px;
    }
  }
</style>
