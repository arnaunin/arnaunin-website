---
/** Hero de La Suite, amb una vista prèvia estàtica del formulari de reserves. */
import EtiquetaExemple from '../comu/EtiquetaExemple.astro';
import Icona from '../comu/Icona.astro';
import Llum from '../comu/Llum.astro';
import Marca from '../comu/Marca.astro';
import Onades from '../comu/Onades.astro';
import { textos, type Idioma } from '../../i18n';

interface Props {
  idioma: Idioma;
}

const t = textos(Astro.props.idioma).suite.hero;
const v = t.vistaPrevia;
---

<section class="hero fosc">
  <Llum mida={480} posicio="right: 10%; top: 8%" />
  <Onades amplada={620} alcada={260} opacitat={0.14} gruix={0.6} posicio="left: -40px; bottom: -20px" />

  <div class="contenidor hero-cos">
    <div class="hero-text">
      <div class="marca-fila entra">
        <Marca fons="fosc" />
        <span class="separador" aria-hidden="true"></span>
        <p class="subtitol">{t.subtitol}</p>
      </div>
      <h1 class="titol-hero entra d1" set:html={t.titolHtml} />
      <p class="entradeta entra d2">{t.entradeta}</p>
      <div class="grup-botons entra d3">
        <a href="#contacte" class="boto boto--principal">{t.botoPrincipal}</a>
        <a href="#per-que" class="boto boto--secundari">{t.botoSecundari}</a>
      </div>
    </div>

    <div class="widget-columna entra d4">
      <!--
        Vista prèvia ESTÀTICA del formulari de reserves (no és interactiva).
        Quan el widget real (un web component) estigui llest, es pot substituir
        el contingut d'aquest div per l'etiqueta del widget i el seu <script>.
      -->
      <div id="widget-reserves" class="vista-previa" role="img" aria-label={`${v.etiqueta}: ${v.descripcio}`}>
        <div class="vp-cap" aria-hidden="true">
          <EtiquetaExemple text={v.etiqueta} fons="clar" />
          <p class="vp-restaurant">{v.restaurant}</p>
          <p class="vp-titol">{v.titol}</p>
        </div>
        <div class="vp-cos" aria-hidden="true">
          <div class="vp-fila">
            <div class="vp-camp">
              <span class="vp-etiqueta">{v.dia}</span>
              <span class="vp-valor"><Icona nom="calendari" mida={16} />{v.diaValor}</span>
            </div>
            <div class="vp-camp">
              <span class="vp-etiqueta">{v.persones}</span>
              <span class="vp-valor"><Icona nom="persones" mida={16} />{v.personesValor}</span>
            </div>
          </div>
          <div class="vp-camp">
            <span class="vp-etiqueta">{v.hora}</span>
            <span class="vp-hores">
              {v.hores.map((hora) => <span class:list={['vp-hora', { triada: hora === v.horaTriada }]}>{hora}</span>)}
            </span>
          </div>
          <div class="vp-camp">
            <span class="vp-etiqueta">{v.nom}</span>
            <span class="vp-valor">{v.nomValor}</span>
          </div>
          <div class="vp-camp">
            <span class="vp-etiqueta">{v.correu}</span>
            <span class="vp-valor">{v.correuValor}</span>
          </div>
          <span class="vp-boto">{v.boto}</span>
          <p class="vp-nota"><Icona nom="correu" mida={14} />{v.nota}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-cos {
    position: relative;
    padding-top: 100px;
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }

  .hero-text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .marca-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .separador {
    width: 48px;
    height: 1px;
    background: var(--color-pissarra);
  }

  .subtitol {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-paper);
  }

  .titol-hero {
    font-family: var(--font-titol);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.06;
    text-wrap: balance;
  }

  .titol-hero :global(em) {
    color: var(--color-sorra);
  }

  .entradeta {
    max-width: 560px;
    font-size: var(--mida-entradeta);
    line-height: 1.65;
    color: var(--color-text-fosc);
  }

  .widget-columna {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 480px;
  }

  /* Vista prèvia estàtica: res no hi sembla clicable. */
  .vista-previa {
    position: relative;
    border-radius: var(--radi-panell);
    background: var(--color-crema);
    color: var(--color-tinta);
    box-shadow: var(--ombra-fosca);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    cursor: default;
    user-select: none;
  }

  .vista-previa * {
    cursor: default;
  }

  .vp-cap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vp-cap :global(.etiqueta-exemple) {
    margin-bottom: 8px;
  }

  .vp-restaurant {
    font-size: 13px;
    color: var(--color-text-suau);
  }

  .vp-titol {
    font-family: var(--font-titol);
    font-size: 1.6rem;
    line-height: 1.15;
  }

  .vp-cos {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vp-fila {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .vp-camp {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .vp-etiqueta {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-suau);
  }

  .vp-valor {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 12px;
    border: 1px solid var(--color-linia-clara);
    border-radius: var(--radi-camp);
    background: var(--color-blanc);
    font-size: 14px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .vp-valor :global(svg) {
    flex: none;
    color: var(--color-torrat);
  }

  .vp-hores {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .vp-hora {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 1px solid var(--color-linia-clara);
    border-radius: var(--radi-camp);
    background: var(--color-blanc);
    font-size: 13px;
    font-weight: 600;
  }

  .vp-hora.triada {
    border-color: var(--color-mariner);
    background: var(--color-mariner);
    color: var(--color-paper);
  }

  .vp-boto {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 4px;
    border-radius: var(--radi-pindola);
    background: var(--color-mariner);
    color: var(--color-paper);
    font-size: 15px;
    font-weight: 600;
  }

  .vp-nota {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-suau);
    text-align: center;
  }

  .vp-nota :global(svg) {
    flex: none;
  }

  @media (max-width: 700px) {
    .hero-cos {
      padding-top: 56px;
      padding-bottom: 88px;
    }
  }
</style>
