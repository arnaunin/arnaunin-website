---
import { Picture } from 'astro:assets';
import barca from '../../assets/img/barca.jpg';
import forum from '../../assets/img/forum.jpg';
import { textos, type Idioma } from '../../i18n';

interface Props {
  idioma: Idioma;
}

const t = textos(Astro.props.idioma);
const p = t.inici.projectes;
const captures: Record<string, ImageMetadata> = { barca, forum };
---

<section id="projectes" class="clar vora-superior">
  <div class="contenidor seccio projectes">
    <div class="capcalera-seccio revela">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 class="titol">{p.titol}</h2>
    </div>

    <div class="graella">
      {
        p.llista.map((projecte) => (
          <article class="targeta-p revela">
            <div class="barra" aria-hidden="true">
              <span />
              <span />
              <span />
            </div>
            <div class="captura-marc">
              <Picture
                class="captura"
                src={captures[projecte.id]!}
                alt={projecte.alt}
                formats={['avif', 'webp']}
                widths={[400, 600, 800, 1140]}
                sizes="(max-width: 720px) calc(100vw - 48px), (max-width: 1248px) calc(50vw - 40px), 568px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="targeta-cos">
              <p class="categoria">{projecte.categoria}</p>
              <h3 class="nom">{projecte.nom}</h3>
              <p class="text">{projecte.text}</p>
              <a href={projecte.url} class="enllac" target="_blank" rel="noopener">
                {p.visita}
                <span class="visualment-amagat">: {projecte.nom} {t.comu.obreNovaFinestra}</span>
                <span aria-hidden="true">&nbsp;→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projectes {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .capcalera-seccio {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
  }

  .graella {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 32px;
  }

  .targeta-p {
    background: var(--color-blanc);
    border: 1px solid var(--color-linia-clara);
    border-radius: var(--radi-targeta);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s var(--corba-entrada),
      box-shadow 0.35s ease;
  }

  .targeta-p:hover {
    transform: translateY(-6px);
    box-shadow: var(--ombra-targeta);
  }

  .barra {
    background: var(--color-mariner);
    padding: 10px 14px;
    display: flex;
    gap: 6px;
  }

  .barra span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-pissarra);
  }

  .captura-marc {
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: var(--color-maqueta-captura);
  }

  .captura-marc :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.6s var(--corba-entrada);
  }

  .targeta-p:hover .captura-marc :global(img) {
    transform: scale(1.035);
  }

  .targeta-cos {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .categoria {
    font-size: 13px;
    color: var(--color-torrat);
    font-weight: 600;
  }

  .nom {
    font-family: var(--font-titol);
    font-weight: 500;
    font-size: 1.6rem;
  }

  .text {
    line-height: 1.6;
    color: var(--color-text-clar);
  }

  .enllac {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-mariner);
    font-weight: 600;
  }

  .enllac:hover {
    color: var(--color-torrat);
  }
</style>
