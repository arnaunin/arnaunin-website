---
import AvisFlotant from '../comu/AvisFlotant.astro';
import Llum from '../comu/Llum.astro';
import Onades from '../comu/Onades.astro';
import { textos, type Idioma } from '../../i18n';

interface Props {
  idioma: Idioma;
}

const t = textos(Astro.props.idioma).inici.hero;
---

<section id="inici" class="hero fosc">
  <Llum mida={460} posicio="right: 8%; top: 12%" intensitat="mitjana" />
  <Onades amplada={760} alcada={300} opacitat={0.14} posicio="left: -60px; bottom: -40px" />

  <div class="contenidor hero-cos">
    <div class="hero-text">
      <p class="ubicacio entra"><span class="punt"></span>{t.ubicacio}</p>
      <h1 class="titol-hero entra d1">
        {t.titolAbans}<span class="subratllat"><em>{t.titolDestacat}</em><svg
            aria-hidden="true"
            focusable="false"
            width="100%"
            height="14"
            viewBox="0 0 300 14"
            preserveAspectRatio="none"><path class="subratlla" d="M3 9 C 70 2, 150 2, 297 8" fill="none" stroke-width="3" stroke-linecap="round"></path></svg
          ></span>{t.titolDespres}
      </h1>
      <p class="entradeta entra d2">{t.entradeta}</p>
      <div class="grup-botons entra d3">
        <a href="#contacte" class="boto boto--principal">{t.botoPrincipal}</a>
        <a href="#projectes" class="boto boto--secundari">{t.botoSecundari}</a>
      </div>
    </div>

    <!-- Maqueta decorativa: una web que es carrega -->
    <div class="maqueta entra d4" aria-hidden="true">
      <div class="navegador sura" style="--r: -2deg">
        <div class="navegador-barra">
          <span class="boli"></span><span class="boli"></span><span class="boli"></span>
          <span class="adreca"><span class="escriu">{t.maqueta.url}</span></span>
        </div>
        <div class="navegador-cos">
          <div class="b b-eyebrow"></div>
          <div class="b b-titol" style="width: 85%"></div>
          <div class="b b-titol" style="width: 62%"></div>
          <div class="b b-text" style="width: 90%; margin-top: 6px"></div>
          <div class="b b-text" style="width: 75%"></div>
          <div class="b-botons"><div class="b-boto"></div><div class="b-boto b-boto--vora"></div></div>
          <div class="b-graella"><div></div><div></div><div></div></div>
        </div>
      </div>

      <div class="velocitat-pos" style="--retard: 2.4s">
        <div class="velocitat sura sura2">
          <span class="velocitat-xifra">100</span>
          <span class="velocitat-text" set:html={t.maqueta.velocitatHtml} />
        </div>
      </div>

      <AvisFlotant
        titol={t.maqueta.avisTitol}
        text={t.maqueta.avisText}
        icona="correu"
        mida="mitjana"
        posicio="left: -30px; bottom: 0"
        costat="esquerra"
        retard={3.2}
        surar="sura3"
        ampladaMaxima={290}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-cos {
    position: relative;
    padding-top: 100px;
    padding-bottom: 130px;
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }

  .hero-text {
    flex: 1 1 540px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .ubicacio {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--color-text-fosc);
  }

  .titol-hero {
    font-family: var(--font-titol);
    font-weight: 400;
    font-size: clamp(2.7rem, 5.8vw, 4.8rem);
    line-height: 1.04;
    letter-spacing: -0.5px;
    text-wrap: balance;
  }

  .titol-hero em {
    color: var(--color-sorra);
  }

  /* Si la paraula destacada no hi cap, pot partir-se en línies (max-width). */
  .subratllat {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .subratllat svg {
    position: absolute;
    left: 0;
    bottom: -8px;
  }

  .subratlla {
    stroke: var(--color-sorra);
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: dibuixa 1.1s 0.9s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }

  @keyframes dibuixa {
    to {
      stroke-dashoffset: 0;
    }
  }

  .entradeta {
    max-width: 580px;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-fosc);
  }

  .hero-text .grup-botons {
    margin-top: 8px;
  }

  /* ---- Maqueta ---- */
  .maqueta {
    flex: 1 1 400px;
    min-width: 0;
    max-width: 470px;
    position: relative;
    padding: 20px 0 40px;
  }

  .navegador {
    background: var(--color-crema);
    border-radius: var(--radi-targeta);
    overflow: hidden;
    box-shadow: var(--ombra-fosca);
  }

  .navegador-barra {
    background: var(--color-maqueta-barra);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .boli {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-maqueta-gris);
  }

  .adreca {
    margin-left: 10px;
    flex: 1;
    background: var(--color-crema);
    border-radius: var(--radi-pindola);
    padding: 4px 12px;
    font-size: 11px;
    color: var(--color-text-suau);
  }

  .escriu {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    white-space: nowrap;
    animation: escriu 1.6s 1.2s steps(28) both;
  }

  @keyframes escriu {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .navegador-cos {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .b {
    border-radius: 4px;
  }

  .b-eyebrow {
    width: 34%;
    height: 8px;
    background: var(--color-torrat);
    opacity: 0.7;
  }

  .b-titol {
    height: 18px;
    border-radius: 5px;
    background: var(--color-mariner);
  }

  .b-text {
    height: 7px;
    background: var(--color-maqueta-linia);
  }

  .b-botons {
    display: flex;
    gap: 10px;
    margin-top: 8px;
  }

  .b-boto {
    width: 96px;
    height: 28px;
    border-radius: var(--radi-pindola);
    background: var(--color-sorra);
  }

  .b-boto--vora {
    width: 80px;
    background: none;
    border: 1.5px solid var(--color-maqueta-gris);
  }

  .b-graella {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 10px;
  }

  .b-graella div {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    background: var(--color-maqueta-barra);
  }

  .velocitat-pos {
    position: absolute;
    right: -24px;
    top: -6px;
    z-index: 1;
    animation: avis 0.7s var(--retard) var(--corba-avis) both;
  }

  .velocitat {
    background: var(--color-mariner-profund);
    border: 1px solid var(--color-linia-fosca);
    color: var(--color-paper);
    border-radius: var(--radi-avis);
    padding: 12px 16px;
    box-shadow: var(--ombra-avis);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .velocitat-xifra {
    font-family: var(--font-titol);
    font-size: 1.6rem;
    color: var(--color-sorra);
    line-height: 1;
  }

  .velocitat-text {
    font-size: 12px;
    line-height: 1.3;
    color: var(--color-text-fosc);
  }

  @media (max-width: 700px) {
    .hero-cos {
      padding-top: 56px;
      padding-bottom: 88px;
    }

    .velocitat-pos {
      right: -6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subratlla {
      stroke-dashoffset: 0;
    }
  }
</style>
