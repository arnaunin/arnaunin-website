---
/**
 * Etiqueta visible que marca una maqueta com a exemple («Vista prèvia»,
 * «Exemple visual», «Dades d'exemple»), perquè no sembli una eina real ni dades reals.
 */
interface Props {
  text: string;
  /** Fons on va l'etiqueta. */
  fons?: 'clar' | 'fosc';
}

const { text, fons = 'fosc' } = Astro.props;
---

<span class:list={['etiqueta-exemple', `etiqueta-exemple--${fons}`]}>{text}</span>

<style>
  .etiqueta-exemple {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    padding: 4px 10px;
    border-radius: var(--radi-pindola);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    line-height: 1.4;
    white-space: nowrap;
  }

  .etiqueta-exemple::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .etiqueta-exemple--fosc {
    border: 1px solid var(--color-pissarra);
    color: var(--color-sorra);
  }

  .etiqueta-exemple--clar {
    border: 1px solid var(--color-maqueta-gris);
    color: var(--color-torrat);
  }

  @media (max-width: 420px) {
    .etiqueta-exemple {
      padding: 3px 8px;
      font-size: 10px;
      letter-spacing: 0.8px;
    }
  }
</style>
