---
/**
 * Icones de línia (traç 1.6, 24 px) de la guia d'estils.
 * El color és el del text (`currentColor`).
 */
const camins = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/>',
  eina: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>',
  bossa: '<path d="M6 2h12l-1.5 4h-9z"/><path d="M4 6h16l-1.5 14h-13z"/><path d="M9 11a3 3 0 0 0 6 0"/>',
  escut: '<path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  rellotge: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  sala: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>',
  campana: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
  persones:
    '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21 20c0-2.6-1.6-4.8-4-5.6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  correu: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  whatsapp:
    '<path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.6z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 1c-1-.5-2.3-1.8-2.8-2.8l1-1-1-2z"/>',
  calendari:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M9 15l2 2 4-4"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  tanca: '<path d="M6 6l12 12M18 6L6 18"/>',
} as const;

export type NomIcona = keyof typeof camins;

interface Props {
  nom: NomIcona | string;
  mida?: number;
  gruix?: number;
  class?: string;
}

const { nom, mida = 24, gruix = 1.6, class: classe } = Astro.props;
const contingut = camins[nom as NomIcona] ?? '';
---

<svg
  class={classe}
  aria-hidden="true"
  focusable="false"
  width={mida}
  height={mida}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={gruix}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={contingut}
/>
